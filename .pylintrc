[MASTER]
jobs=0
ignore-paths=custom_components/scene_extrapolation/frontend

[MESSAGES CONTROL]
# HA is installed in CI; keep import-error disabled so local pylint without the
# full HA tree still works. Disable complexity/length noise common in HA
# integrations (especially legacy scene.py) without rewriting that module.
disable=
    C0114,
    C0116,
    C0301,
    C0302,
    E0401,
    R0902,
    R0903,
    R0911,
    R0912,
    R0913,
    R0914,
    R0915,
    R0917,
    W0221,
    W0223,
    W0511,
    W0613,
    W0718,

[FORMAT]
max-line-length=100

[DESIGN]
max-args=5
max-locals=15
max-branches=12
max-statements=50
